# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Credentials — tests/multiaiproxy.py loads provider API keys via dotenv
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Dev wheels built by scripts/dev_wheel.sh into a modules folder.
# The generated wapyt/pytincture-assets.json IS committed -- a source build
# needs it, and scripts/generate_assets_manifest.py --check guards it in CI.
*-py3-none-any.whl
uv.lock
tests/uv.lock
